{
  "name": "tihoka",
  "version": "0.1.10",
  "description": "Tihoka - Chrome MV3 extension: turn any content into study material (video + subtitle capture + Anki cards)",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-tokens.js",
    "dev": "vite",
    "prebuild": "node scripts/generate-tokens.js && node scripts/check-icons.js && node scripts/check-feature-cycles.mjs && npm run check-design-system-css:features",
    "build": "vite build",
    "prebuild:dev": "node scripts/generate-tokens.js",
    "build:dev": "vite build --mode development",
    "postbuild:dev": "node scripts/patch-ocr-csp.mjs",
    "build:fast": "node scripts/generate-tokens.js && vite build --mode fast",
    "prebuild:mock": "node scripts/generate-tokens.js",
    "build:mock": "vite build --mode mock",
    "postbuild": "node scripts/patch-ocr-csp.mjs",
    "ship:dist": "powershell -ExecutionPolicy Bypass -File scripts/ship-dist.ps1",
    "ship:imobile": "node scripts/ship-mobile.mjs",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/ship-dist.ps1 -Bump patch -Build",
    "release:minor": "powershell -ExecutionPolicy Bypass -File scripts/ship-dist.ps1 -Bump minor -Build",
    "release:major": "powershell -ExecutionPolicy Bypass -File scripts/ship-dist.ps1 -Bump major -Build",
    "release:github": "powershell -ExecutionPolicy Bypass -File scripts/release-github.ps1",
    "design-system": "npx http-server build/showcase -p 8123 -c-1 -o /design-system-showcase.html",
    "design-system:dev": "vite --config vite.showcase.config.ts",
    "design-system:open:universal-panel": "start \"Cell\" chrome \"http://localhost:5180/src/entrypoints/design-system-showcase/index.html?showcase=Universal+Panel+Page&mode=light&viewport=full\"",
    "build:design-system": "vite build --config vite.showcase.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview": "vite preview",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "jest --selectProjects integration",
    "test:fast": "jest --selectProjects unit --passWithNoTests",
    "test:unit:design-system": "jest --selectProjects unit --passWithNoTests --testPathPatterns tests/unit/scripts --testPathPatterns tests/unit/entrypoints/design-system-showcase --testPathPatterns src/shared/ui",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --selectProjects unit --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:build": "node scripts/build-e2e.mjs",
    "test:e2e:stage2": "npx playwright test --config=playwright.stream.config.ts e2e/stage2/ --project=stage2",
    "test:e2e:full": "npm run test:e2e:build && npm run test:e2e:stage2",
    "test:e2e:firefox": "npm run build:firefox && node e2e/firefox/run.mjs",
    "test:e2e:firefox:attach": "node e2e/firefox/run.mjs --rdp-port",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check-design-system-css": "node scripts/check-design-system-css.mjs",
    "check-design-system-css:features": "node scripts/check-design-system-css.mjs --rules undefined-token src/features/universalPanel src/features/sessionRecap src/features/studyModes src/features/vocabulary src/features/settings src/features/dictionaryPopup src/features/cardCreator",
    "check:cycles": "node scripts/check-feature-cycles.mjs",
    "check-icons": "node scripts/check-icons.js",
    "mock": "node scripts/serve-mock-pages.mjs",
    "mock:stream": "node scripts/serve-mock-pages.mjs --stream",
    "mock:stream:iframe": "node scripts/serve-mock-pages.mjs --stream-iframe",
    "mock:youtube": "node scripts/serve-mock-pages.mjs --youtube",
    "mock:build": "node scripts/serve-mock-pages.mjs --build-only",
    "generate:component-inventory": "node scripts/generate-component-inventory.mjs",
    "generate:design-system-health-report": "node scripts/generate-design-system-health-report.mjs",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@crxjs/vite-plugin": "^2.7.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "crx3": "2.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "http-server": "^14.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "jiti": "^2.7.0",
    "js-mdict": "^7.0.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@jocelyn-stericker/espeak-phonemes": "0.0.5",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "country-flag-icons": "^1.6.20",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.46.0",
    "mux.js": "^6.3.0",
    "onnxruntime-web": "1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sql.js": "^1.14.1",
    "ts-fsrs": "5.4.2",
    "unzipit": "2.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
