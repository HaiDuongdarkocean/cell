      {
        "id": "css-028",
        "category": "naming",
        "severity": "MUST_NOT",
        "trigger": "BEM element nesting",
        "rule": "Do not reflect full DOM ancestry in element names; use .block__element, not .block__parent__child.",
        "example": {
          "bad": [
