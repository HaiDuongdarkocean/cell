        "category": "naming",
        "severity": "MUST",
        "trigger": "BEM block scope",
        "rule": "Start BEM block context at the most logical self-contained discrete component, not a higher container.",
        "example": {
          "bad": [
            ".page__content { }",
            ".page__footer { }"
