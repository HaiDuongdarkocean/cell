  "cacheKeyCases": [
    {
      "id": "basic-bucket",
      "videoId": "abc123",
      "timeMs": 5000,
      "bucketMs": 1000,
      "expectedKey": "abc123:5000"
    },
    {
      "id": "round-down-bucket",
      "videoId": "abc123",
      "timeMs": 5999,
      "bucketMs": 1000,
      "expectedKey": "abc123:5000",
      "comment": "5999ms rounds down to 5000ms bucket"
    },
    {
      "id": "different-bucket-size",
      "videoId": "abc123",
      "timeMs": 5500,
      "bucketMs": 2000,
      "expectedKey": "abc123:4000"
    },
    {
      "id": "zero-time",
      "videoId": "abc123",
      "timeMs": 0,
      "bucketMs": 1000,
      "expectedKey": "abc123:0"
    },
    {
      "id": "different-video-same-time",
      "videoId": "xyz789",
      "timeMs": 5000,
      "bucketMs": 1000,
      "expectedKey": "xyz789:5000"
    }
  ],
  "videoIdCases": [
    {
      "id": "youtube-url",
      "input": { "src": "https://www.youtube.com/watch?v=dQw4w9WgXcQ", "duration": 212 },
      "comment": "YouTube — extract videoId from URL",
      "expectedContains": "dQw4w9WgXcQ"
    },
    {
      "id": "blob-url",
      "input": { "src": "blob:https://themoviebox.xyz/abc-def-123", "duration": 3600 },
      "comment": "Blob URL — hash(src + duration)",
      "expectedLength": 16
    },
    {
      "id": "direct-url",
      "input": { "src": "https://cdn.example.com/video.mp4", "duration": 1800 },
      "comment": "Direct URL — hash(src + duration)",
      "expectedLength": 16
    }
  ]
}
