/mockup-*.html
/tmp_*

# Private keys & CRX binaries (test signing artifacts — NEVER commit secrets).
*-key.pem
*.crx

# Windows reserved-name junk file.
/nul

# Python bytecode cache.
__pycache__/

# Backup files.
*.md.bak

# Local test media (210MB+, not part of extension source).
data/resource/media/

# Generated token files (source of truth is src/shared/styles/tokens.json).
