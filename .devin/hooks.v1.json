{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-session-prime.mjs",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node scripts/hook-ponytail-activate.mjs",
          "timeout": 15
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(write|edit|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-stage-guard.mjs",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node scripts/hook-lessons.mjs",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node scripts/hook-adr-refs.mjs",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-commit-gates.mjs",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(write|edit|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-skill-index.mjs",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-gates-tracker.mjs",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "node scripts/hook-owner-bind.mjs",
          "timeout": 5
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-context-restore.mjs",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-stop-gate.mjs",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-session-report.mjs",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node scripts/hook-ponytail.mjs",
          "timeout": 5
        }
      ]
    }
  ]
}
