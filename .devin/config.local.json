{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--categoryExtensions",
        "--isolated",
        "--chromeArg=--enable-unsafe-extension-debugging",
        "--allow-unrestricted-paths"
      ]
    }
  }
}
