{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "0.1.3",
  "description": "__MSG_extDescription__",
  "key": "",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "downloads",
    "storage",
    "offscreen",
    "activeTab",
    "tabs",
    "sidePanel",
    "webNavigation",
    "cookies",
    "tts",
    "unlimitedStorage",
    "alarms",
    "identity",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/entrypoints/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/entrypoints/content/content-script.ts"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/entrypoints/content/fetchInterceptor.iife.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/entrypoints/content/subtitleDiscovery-main-world.iife.ts"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/entrypoints/content/youtube-main-world.iife.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.iq.com/*",
        "*://*.iqiyi.com/*"
      ],
      "js": [
        "src/entrypoints/content/iqiyi-main-world.iife.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "src/entrypoints/content/netflix-main-world.iife.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "options_page": "public/options.html",
  "side_panel": {
    "default_path": "src/entrypoints/sidepanel/index.html"
  },
  "action": {
    "default_popup": "src/entrypoints/popup/index.html",
    "default_title": "__MSG_extName__",
    "default_icon": "public/icons/icon-48.png"
  },
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http: https:"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "sql-wasm.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "src/entrypoints/local-player/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "src/entrypoints/srs-study/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}