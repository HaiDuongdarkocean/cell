{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "0.1.0",
  "description": "Detect and download video + subtitle from free streaming sites for language learners",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "offscreen",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/entrypoints/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/entrypoints/content/content-script.ts"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/entrypoints/content/fetchInterceptor.iife.ts"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "side_panel": {
    "default_path": "src/entrypoints/sidepanel/index.html"
  },
  "action": {
    "default_popup": "src/entrypoints/popup/index.html",
    "default_title": "Video Downloader",
    "default_icon": "public/icons/icon-48.png"
  },
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
